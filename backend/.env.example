# Cadena de conexion a la base de datos de Supabase (Postgres)
# La encuentras en: Project Settings > Database > Connection string > URI
# (usa el "Connection pooling" / puerto 6543 en produccion si aplica)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# Puerto donde corre la API
PORT=3000

# Clave secreta para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_segura
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (URL del frontend Angular)
CORS_ORIGIN=http://localhost:4200
